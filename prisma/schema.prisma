// bv-backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      String   @default("seller")
  createdAt DateTime @default(now())
}

model Category {
  id   Int    @id @default(autoincrement())
  name String @unique   // agregado @unique — necesario para que el upsert por name funcione sin duplicados

  cars Car[]
}

model Car {
  id           Int      @id @default(autoincrement())

  brand        String
  model        String
  version      String?

  year         Int

  price        Float
  offerPrice   Float?

  kilometers   Int

  transmission String?
  fuelType     String?

  condition    String?  // valores esperados: "NUEVO" | "USADO"

  description  String?
  shortDesc    String?

  location     String?

  uniqueOwner  Boolean  @default(false)
  transferable Boolean  @default(true)
  acceptsTrade Boolean  @default(false)

  saleType     String?  // valores esperados: "CONTADO" | "FINANCIADO" | "AMBOS"

  featured     Boolean  @default(false)
  visible      Boolean  @default(true)
  sold         Boolean  @default(false)
  reserved     Boolean  @default(false)

  slug         String?  @unique  // agregado @unique — para URLs amigables sin colisiones

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  categoryId   Int?
  category     Category? @relation(fields: [categoryId], references: [id])

  images       CarImage[]
}

model CarImage {
  id      Int     @id @default(autoincrement())
  url     String
  isCover Boolean @default(false)
  carId   Int
  car     Car     @relation(fields: [carId], references: [id], onDelete: Cascade)
}

// enum CarCondition eliminado — Car.condition es String?, este enum nunca se usó
